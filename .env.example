# Copy this file to .env and fill in your values. Never commit .env.

# Redis persistence (optional). Set to true to keep tasks across restarts.
REDIS_ENABLED=false

# Redis connection string, required when REDIS_ENABLED=true.
#   Local:  redis://localhost:6379/0
#   Cloud:  redis://default:PASSWORD@host:port
REDIS_URL=redis://localhost:6379/0

# How long (seconds) a task stays in Redis before auto-deleting (TTL).
#   0      = never delete (keep forever)
#   60     = 1 minute
#   3600   = 1 hour
#   86400  = 1 day
#   604800 = 1 week
REDIS_TASK_TTL=3600
